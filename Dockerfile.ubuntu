FROM ubuntu:24.04

# Prevent interactive prompts during package install
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies: Python 3, Node.js 22, supervisor, tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    ca-certificates \
    gnupg \
    git \
    supervisor \
    tzdata \
    && ln -sf /usr/share/zoneinfo/${TZ} /etc/localtime \
    && echo "${TZ}" > /etc/timezone \
    # Install Node.js 22 from NodeSource
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    # Clean up
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create working directories
WORKDIR /app/Backend
COPY Backend/ /app/Backend/

# Install Python dependencies
RUN pip3 install --break-system-packages --no-cache-dir -r requirements.txt

# Install and build DataService
WORKDIR /app/DataService
COPY DataService/ /app/DataService/
RUN npm install && npm run build

# Install and build Frontend
WORKDIR /app/Frontend
COPY Frontend/ /app/Frontend/
RUN npm install && npm run build

# Copy frontend build output to Flask static folder
RUN mkdir -p /app/Backend/static && cp -r /app/Frontend/dist/* /app/Backend/static/

# Copy supervisord config
COPY supervisord.conf /etc/supervisor/conf.d/gofundbot.conf

EXPOSE 5000

WORKDIR /app
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
